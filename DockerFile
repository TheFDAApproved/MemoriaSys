FROM php:8.5.12-apache

# Install system dependencies and PHP extensions needed for MySQL
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    zip \
    unzip \
    git \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql gd

# Enable Apache mod_rewrite for clean URLs if needed
RUN a2enmod rewrite

# Copy project files into the Apache public directory
COPY . /var/apache/html/
# (Or to /var/www/html/ depending on your setup)

EXPOSE 80